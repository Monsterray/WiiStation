# libsmb2.a for WiiStation: the SMB2/3 client library (github.com/sahlberg/libsmb2, tag v6.0.0,
# LGPL-2.1), with the patches Docs/BACKENDS.md lists ("libsmb2 patches": the Wii port's byte
# order and socket calls), built against libogc2 with devkitPPC r41-2 like the rest of
# WiiStation. This file is WiiStation's. Kerberos is left out; the DCE/RPC files are in only so
# that share listing links.
#
#   make -C deps/libsmb2 -f Makefile.wiistation DEVKITPRO=/c/devkitPro DEVKITPPC=/c/devkitPro/devkitPPC-r41-2

ifeq ($(strip $(DEVKITPPC)),)
$(error "Set DEVKITPPC in your environment.")
endif

PREFIX = $(DEVKITPPC)/bin/powerpc-eabi-
CC = $(PREFIX)gcc
AR = $(PREFIX)ar
BUILD = build-wii

CFLAGS = -DGEKKO -D__WII__ -mrvl -mcpu=750 -meabi -mhard-float -O2 -Wall -Wno-unused-variable \
	-Wno-unused-but-set-variable -Wno-unused-function -D_U_= \
	-DNEED_GETLOGIN_R -DNEED_GETADDRINFO -DNEED_FREEADDRINFO \
	-DHAVE_STDINT_H -DHAVE_STDLIB_H -DHAVE_STRING_H -DHAVE_TIME_H -DHAVE_SYS_TIME_H \
	-DHAVE_UNISTD_H -DHAVE_SYS_TYPES_H -DHAVE_SYS_STAT_H -DHAVE_ERRNO_H -DHAVE_STDIO_H \
	-DHAVE_FCNTL_H -DHAVE_STRINGS_H -DHAVE_LINGER \
	-Dbind=net_bind -Dlisten=net_listen -Daccept=net_accept \
	-Iinclude -Iinclude/smb2 -Ilib \
	-I$(DEVKITPRO)/libogc2/include -I$(DEVKITPRO)/portlibs/ppc/include

SRC = aes.c aes128ccm.c alloc.c asn1-ber.c compat.c errors.c init.c hmac.c hmac-md5.c \
	libsmb2.c md4c.c md5.c ntlmssp.c pdu.c sha1.c sha224-256.c sha384-512.c \
	smb2-cmd-close.c smb2-cmd-create.c smb2-cmd-echo.c smb2-cmd-error.c smb2-cmd-flush.c \
	smb2-cmd-ioctl.c smb2-cmd-lock.c smb2-cmd-logoff.c smb2-cmd-negotiate.c \
	smb2-cmd-notify-change.c smb2-cmd-oplock-break.c smb2-cmd-query-directory.c \
	smb2-cmd-query-info.c smb2-cmd-read.c smb2-cmd-session-setup.c smb2-cmd-set-info.c \
	smb2-cmd-tree-connect.c smb2-cmd-tree-disconnect.c smb2-cmd-write.c smb2-data-file-info.c \
	smb2-data-filesystem-info.c smb2-data-reparse-point.c smb2-data-security-descriptor.c \
	smb2-share-enum.c smb2-signing.c smb3-seal.c socket.c spnego-wrapper.c sync.c timestamps.c \
	unicode.c usha.c dcerpc.c dcerpc-lsa.c dcerpc-srvsvc.c
OBJ = $(addprefix $(BUILD)/,$(SRC:.c=.o))

lib/wii/libsmb2.a: $(OBJ)
	mkdir -p lib/wii
	rm -f $@
	$(AR) rcs $@ $^

$(BUILD)/%.o: lib/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD) lib/wii
